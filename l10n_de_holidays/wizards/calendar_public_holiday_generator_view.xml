<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_public_holiday_generator_view" model="ir.ui.view">
        <field name="name">calendar.public.holiday.generator.view</field>
        <field name="model">calendar.public.holiday.generator</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Generate Public Holidays">
                <group col="2" colspan="2">
                    <field name="year" options="{'type': 'number'}" />
                    <field name="country_id" options="{'no_create': True}" />
                    <field
                        name="state_id"
                        options="{'no_create': True}"
                        domain="[('country_id', '=', country_id)]"
                    />
                    <field name="template_id" options="{'no_create': True}" />
                </group>
                <footer>
                    <button
                        name="action_run"
                        string="Generate"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="calendar_public_holiday_generator_action" model="ir.actions.act_window">
        <field name="name">Generate Public Holidays</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">calendar.public.holiday.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="calendar_public_holiday_generator_menu"
        name="Generate Public Holidays"
        parent="calendar_public_holiday.menu_calendar_public_holiday"
        action="calendar_public_holiday_generator_action"
    />
</odoo>
