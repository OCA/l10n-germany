        <field name="name">Three Kings Day</field>
        <field name="date_type">fixed</field>
        <field name="date">2000-01-06</field>
        <field
            name="state_ids"
            eval="[Command.set([ref('base.state_de_bw'), ref('base.state_de_by'), ref('base.state_de_st')])]"
        />
    </record>
