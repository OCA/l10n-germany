<odoo noupdate="1">
    <record
        id="calendar_public_holiday_template_de"
        model="calendar.public.holiday.template"
    >
        <field name="name">Germany</field>
        <field name="country_id" ref="base.de" />
    </record>
    <record
        id="calendar_public_holiday_template_de_new_year"
        model="calendar.public.holiday.template.line"
    >
        <field name="template_id" ref="calendar_public_holiday_template_de" />
        <field name="name">New Year's Day</field>
        <field name="date_type">fixed</field>
        <field name="date">2000-01-01</field>
    </record>
