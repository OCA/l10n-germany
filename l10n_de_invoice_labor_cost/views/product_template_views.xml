<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field
            name="name"
        >product.template.form.inherit.l10n_de_invoice_labor_cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='general_information']//group[@name='group_general']"
                position="after"
            >
                <group
                    string="§35a Labor Cost"
                    name="labor_cost_group"
                    invisible="type != 'service'"
                >
                    <field name="is_labor_cost_product" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
