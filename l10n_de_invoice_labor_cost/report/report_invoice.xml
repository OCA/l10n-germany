<odoo>
    <template
        id="report_invoice_labor_cost"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//div[@id='payment_term']" position="after">
            <div
                t-if="o.l10n_de_labor_cost_gross > 0"
                class="mt-3 mb-3 p-2 border rounded"
                style="border-color: #dee2e6 !important;"
            >
                <p class="fw-bold mb-1">Note according to §35a EStG:</p>
                <p class="mb-0">
                    In the invoice amount of
                    <span
                    t-field="o.amount_total"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
                    are
                    <span
                    t-field="o.l10n_de_labor_cost_gross"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
                    Labor costs (gross) included.
                    <br />
                    Labor costs included (net):
                    <span
                    t-field="o.l10n_de_labor_cost_net"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
                    <br />
                    Sales tax included:
                    <span
                    t-field="o.l10n_de_labor_cost_tax"
                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
                </p>
            </div>
        </xpath>
    </template>
</odoo>
