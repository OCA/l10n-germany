<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ag" model="res.partner.company.type">
        <field name="name">Aktiengesellschaft</field>
        <field name="shortcut">AG</field>
        <field name="country_ids" eval="[(4, ref('base.de'))]" />
    </record>

    <record id="eg" model="res.partner.company.type">
        <field name="name">Eingetragene Genossenschaft</field>
        <field name="shortcut">eG</field>
        <field name="country_ids" eval="[(4, ref('base.de'))]" />
    </record>

    <record id="gmbh" model="res.partner.company.type">
        <field name="name">Gesellschaft mit beschränkter Haftung</field>
        <field name="shortcut">GmbH</field>
        <field name="country_ids" eval="[(4, ref('base.de'))]" />
    </record>

    <record id="sdpr" model="res.partner.company.type">
        <field name="name">Stiftung des privaten Rechts</field>
        <field name="shortcut">SdpR</field>
        <field name="country_ids" eval="[(4, ref('base.de'))]" />
    </record>
</odoo>
