<odoo>
    <record id="view_l10n_de_tax_report_form" model="ir.ui.view">
        <field name="model">l10n.de.tax.statement</field>
        <field name="inherit_id"
               ref="l10n_de_tax_statement.view_l10n_de_tax_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='statement_update']"
                   position="after">
                <button
                    name="action_generate_elster_xml"
                    string="ELSTER XML herunterladen"
                    type="object"
                    icon="fa-download"
                    invisible="state=='draft'"
                    confirm="Die XML-Datei wird zum manuellen Import in Mein ELSTER erzeugt. Fortfahren?"
                />
            </xpath>
        </field>
    </record>
</odoo>
