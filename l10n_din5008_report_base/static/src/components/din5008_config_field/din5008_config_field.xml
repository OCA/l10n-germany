<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="l10n_din5008_report_base.Din5008ConfigField">
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-secondary" t-on-click="openDialog">
                Configure parameters
            </button>

            <button
                type="button"
                class="btn btn-secondary btn-sm"
                t-on-click="resetConfig"
                t-if="hasOverrides"
                title="Reset DIN 5008 Configuration"
            >
                <i class="fa fa-refresh" /> Reset
            </button>
        </div>
    </t>
</templates>
