#. module: l10n_de_report_footer
#: model:ir.model.fields,help:l10n_de_report_footer.field_base_document_layout__report_footer_margin_bottom
#: model:ir.model.fields,help:l10n_de_report_footer.field_res_company__report_footer_margin_bottom
